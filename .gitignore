# Large regenerable artefacts -- everything here is reproducible from scripts/ + refs listed
# in metadata/reference_sources.tsv. Excluded to keep the repo Zenodo-friendly.

# Alignments (~15 GB)
bam/
bam_*/
*.bam
*.bam.bai

# Trimmed FASTQ and intermediate QC (~5 GB)
qc/fastp/*.fq.gz
qc/subsample/
qc/depleted/
qc/trimtest/
qc/unaligned/
qc/testmap/
qc/testmap_depleted/
qc/refcmp/
qc/fcmp/
qc/rrna/

# Reference genomes and databases (~7 GB) -- fetched by scripts/01_fetch_refs.sh.
# Note: the negation below only works because the parent is excluded as refs/* rather than
# refs/ -- git cannot re-include a file whose parent directory is itself excluded.
refs/*
!refs/rRNA_regions_*.tsv

# Conda environments (~9 GB) -- rebuilt by scripts/00_setup_envs.sh
envs/

# Scratch
*.part
*.tmp
.DS_Store
__pycache__/
*.pyc

# LaTeX build artefacts. Only the three document directories are cleaned; latex/template/
# must stay tracked (sn-jnl.cls and the .bst files are required to rebuild).
latex/V0_internal/main.*
latex/P1_resource/main.*
latex/P2_biology/main.*
!latex/*/main.tex
latex/*/sn-jnl.cls
latex/V0_internal/*.bst
latex/P1_resource/*.bst
latex/P2_biology/*.bst
latex/V0_internal/bst/
latex/P1_resource/bst/
latex/P2_biology/bst/
latex/*/refs.bib
!latex/refs.bib
latex/template/sn-article.pdf
latex/template/user-manual.pdf
